# Template for server/.env -- copy to server/.env and fill in.
#
# Holds the PATH to a private key, never key material. Keypair auth is assumed
# (authenticator SNOWFLAKE_JWT); for password auth set SNOWFLAKE_PASSWORD
# instead and drop the authenticator and key path.

SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_USER=my_user
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# Only if the key file is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASS=passphrase
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=LRI_DEMO_WH
SNOWFLAKE_DATABASE=LRI_DEMO
SNOWFLAKE_SCHEMA=LRI_BASE

PORT=3001
